{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Novidades" },
    { "type": "fix", "section": "Correções" },
    { "type": "perf", "section": "Desempenho" },
    { "type": "refactor", "section": "Refatoração" },
    { "type": "docs", "section": "Documentação" },
    { "type": "build", "section": "Build e infraestrutura" },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "test", "section": "Testes", "hidden": true },
    { "type": "chore", "section": "Manutenção", "hidden": true },
    { "type": "style", "section": "Estilo", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "kamus",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "Directory.Build.props",
        { "type": "json", "path": "src/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "src/web/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "src/web/package-lock.json", "jsonpath": "$.packages[''].version" }
      ]
    }
  }
}
