{
  // Vazio = roda em localhost sem PostgreSQL: dados em MEMÓRIA (somem ao reiniciar) e /health = "Degraded".
  // Para usar um banco: dotnet user-secrets set "ConnectionStrings:Kamus" "Host=localhost;Port=5432;Database=kamus;Username=kamus_app;Password=kamus_app_dev" --project src/backend/Kamus.Api
  "ConnectionStrings": {
    "Kamus": ""
  },
  // Valores APENAS para desenvolvimento local. Em produção vêm de variáveis de ambiente (Jwt__Chave).
  "Jwt": {
    "Chave": "chave-de-desenvolvimento-local-nao-usar-em-producao"
  },
  // Painel Administrativo (operador do SaaS): chave própria, diferente da do cliente. Em produção: Admin__Chave.
  "Admin": {
    "Chave": "chave-do-painel-admin-desenvolvimento-local-nao-usar"
  },
  // Origens liberadas por CORS: o app mobile rodando no navegador (npx expo start --web).
  "Cors": {
    "Origens": [ "http://localhost:8081" ]
  },
  // Usuários de teste criados ao subir a API em Development:
  // admin@kamus.local (cliente "Loja Demo") e superadmin@kamus.local (Painel Administrativo)
  "Seed": {
    "SenhaAdmin": "Kamus@Dev123",
    "SenhaSuperAdmin": "Kamus@Admin123"
  }
}
